{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Multilingual Prompt Repetition Benchmark — Results Analysis\n",
    "**Replicating:** arXiv:2512.14982\n",
    "**Languages:** Punjabi (Shahmukhi), Urdu, Pashto, Balochi\n\n",
    "This notebook provides interactive analysis of experiment results:\n",
    "- Accuracy by method (baseline, repetition, verbose, triple, padding)\n",
    "- McNemar statistical significance tests\n",
    "- Figure 1: grouped bar charts\n",
    "- Cross-language comparison"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json, glob, os, sys\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "sys.path.insert(0, str(Path.cwd()))\n",
    "from analysis import (\n",
    "    load_csv, load_json,\n",
    "    compute_accuracy, compute_mcnemar,\n",
    "    print_accuracy_table, print_mcnemar_table,\n",
    "    print_summary, plot_figure1,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load Results\n",
    "\n",
    "Set `RESULTS_FILE` to your results JSON or CSV file."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "RESULTS_FILE = \"results_pa_20260612_114823.json\"  # ← update this\n",
    "\n",
    "p = Path(RESULTS_FILE)\n",
    "if p.exists():\n",
    "    if p.suffix == \".json\":\n",
    "        df = load_json(str(p))\n",
    "    else:\n",
    "        df = load_csv(str(p))\n",
    "    print(f\"Loaded {len(df):,} rows | {df['model'].nunique()} models | {df['scenario'].nunique()} scenarios\")\n",
    "else:\n",
    "    print(f\"File not found: {RESULTS_FILE}\")\n",
    "    print(\"Available result files:\")\n",
    "    for f in sorted(glob.glob(\"results_*.json\")) + sorted(glob.glob(\"results_*.csv\")):\n",
    "        print(f\"  {f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Accuracy Table"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df' in dir():\n",
    "    acc = compute_accuracy(df)\n",
    "    print_accuracy_table(acc)\n",
    "    acc.to_csv(\"accuracy_table.csv\", index=False)\n",
    "    print(\"Saved: accuracy_table.csv\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## McNemar Significance Tests (p < 0.1, correction=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df' in dir():\n",
    "    mc = compute_mcnemar(df)\n",
    "    print_mcnemar_table(mc)\n",
    "    mc.to_csv(\"mcnemar_results.csv\", index=False)\n",
    "    print(\"Saved: mcnemar_results.csv\")\n",
    "\n",
    "if 'mc' in dir():\n",
    "    display(mc[mc['significant']].sort_values('p_value'))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Figure 1: Accuracy by Task × Scenario × Method"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'acc' in dir():\n",
    "    plot_figure1(acc, out_path=\"figure1.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary Statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'acc' in dir() and 'mc' in dir():\n",
    "    print_summary(acc, mc)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cross-Language Wins vs Baseline"
    "\n",
    "Compare which repetition method wins most across languages and scenarios."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "\n",
    "if 'mc' in dir():\n",
    "    # Count wins per method\n",
    "    method_wins = mc.groupby('method').agg(\n",
    "        wins=('direction', lambda x: (x == 'method_better').sum()),\n",
    "        losses=('direction', lambda x: (x == 'baseline_better').sum()),\n",
    "    )\n",
    "    method_wins['net'] = method_wins['wins'] - method_wins['losses']\n",
    "    \n",
    "    fig, ax = plt.subplots(figsize=(10, 5))\n",
    "    methods = [m for m in ['repetition', 'verbose', 'triple', 'padding'] if m in method_wins.index]\n",
    "    wins = [method_wins.loc[m, 'wins'] for m in methods]\n",
    "    losses = [method_wins.loc[m, 'losses'] for m in methods]\n",
    "    x = range(len(methods))\n",
    "    w = 0.35\n",
    "    ax.bar([i - w/2 for i in x], wins, w, label='Wins', color='#2ecc71')\n",
    "    ax.bar([i + w/2 for i in x], losses, w, label='Losses', color='#e74c3c')\n",
    "    ax.set_xticks(x)\n",
    "    ax.set_xticklabels(methods, rotation=15)\n",
    "    ax.set_ylabel('Count')\n",
    "    ax.set_title('Method Performance vs Baseline (McNemar Discordant Pairs)')\n",
    "    ax.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.savefig('method_comparison.png', dpi=150)\n",
    "    plt.show()\n",
    "    \n",
    "    print(method_wins)"
   ]
  }
 ],
