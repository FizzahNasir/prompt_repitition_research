# Overleaf MCP Configuration
# Copy this file to .env and fill in your actual values
# .env is gitignored and will not be committed

# Your Overleaf project ID (from https://www.overleaf.com/project/XXXXXXXXX)
OVERLEAF_PROJECT_ID=your_project_id_here

# Your Overleaf Git access token (from Overleaf → Settings → Git Access)
# Starts with "olp_"
OVERLEAF_GIT_TOKEN=olp_your_token_here

# GitHub Personal Access Token (for GitHub MCP server)
# Create at https://github.com/settings/tokens with "repo" scope
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here